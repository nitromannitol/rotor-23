    title: "Eulerian walkers on Z^2 have range exponent 2/3"
    authors:
      - family-names: Bou-Rabee
        given-names: Ahmed
      - family-names: Peres
        given-names: Yuval
    url: "https://arxiv.org/abs/2608.23545"
